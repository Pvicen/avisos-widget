<?xml version="1.0" encoding="utf-8"?>
<!-- Tarjeta de un aviso importante: franja coral a la izquierda, como en la app -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:right="24dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/acento" />
            <corners
                android:bottomLeftRadius="16dp"
                android:topLeftRadius="16dp" />
        </shape>
    </item>
    <item android:left="4dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/tarjeta" />
            <stroke
                android:width="1dp"
                android:color="@color/borde" />
            <corners
                android:bottomLeftRadius="12dp"
                android:bottomRightRadius="16dp"
                android:topLeftRadius="12dp"
                android:topRightRadius="16dp" />
        </shape>
    </item>
</layer-list>
